# --- ASR ---
ASR_PROVIDER=deepgram            # deepgram | fake (fake = démo sans micro ni clé)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
ASR_LANGUAGE=ar                  # langue parlée PAR DÉFAUT (modifiable dans l'app) : ar, ar-TN, ar-EG, ar-MA, fr, en...
TARGET_LANGUAGE=fr               # langue des sous-titres PAR DÉFAUT (modifiable dans l'app)
ASR_ENDPOINTING_MS=400           # silence avant "speech_final"
ASR_UTTERANCE_END_MS=1000
ASR_KEYTERMS=                    # termes à favoriser, séparés par des virgules

# --- Traduction ---
TRANSLATION_PROVIDER=gemini      # gemini | llm (Claude) | mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GLOSSARY_FILE=glossary.txt       # lignes "arabe = français"
MIN_WORDS_INTERIM=5              # mots stables avant une traduction intermédiaire

# --- Budget (estimations de coût) ---
BUDGET_USD=0                     # limite MENSUELLE en dollars ; 0 = aucune. Modifiable dans l'app.
BUDGET_WARN_PCT=0.8              # alerte à 80 % du budget
DEEPGRAM_USD_PER_MIN=0.0077      # tarif Deepgram utilisé pour l'estimation (à vérifier)
USAGE_FILE=usage.json            # compteur persistant
NOTIFY_WEBHOOK_URL=              # Slack/Discord : reçoit l'alerte à 80 % et à la coupure

# --- Serveur ---
HOST=127.0.0.1
PORT=8765
LOG_LEVEL=INFO

# --- Déploiement cloud (laisser vide en local) ---
AUDIO_SOURCE=local               # local = micro de cette machine | remote = l'app envoie l'audio (cloud)
ACCESS_TOKEN=                    # OBLIGATOIRE sur Internet : jeton exigé par l'app et par OBS
ADMIN_TOKEN=                     # jeton requis pour modifier la limite de budget
